<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <com.copyta.app.TracingView
        android:id="@+id/tracingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#F2F2F7"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:clickable="true"
        android:focusable="true">

        <!-- 高度增加到 110dp，给上方文字留空间 -->
        <com.copyta.app.ScaleSliderView
            android:id="@+id/scaleSlider"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/loadButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/load_image"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:background="@drawable/bg_load_button"
                android:textColor="#FFFFFF"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/resetButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:text="@string/reset"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:background="@drawable/bg_reset_button"
                android:textColor="#1C1C1E"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/colorWhite"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_swatch_white" />

            <View
                android:id="@+id/colorBlack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_swatch_black" />

            <ImageButton
                android:id="@+id/lockButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_lock_button"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:src="@drawable/ic_lock_closed"
                android:contentDescription="@string/lock" />

        </LinearLayout>

    </LinearLayout>

    <ImageButton
        android:id="@+id/floatingUnlockButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_lock_button"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:src="@drawable/ic_lock_open"
        android:visibility="gone"
        android:contentDescription="@string/unlock" />

</FrameLayout>
