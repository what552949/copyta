<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 底层：图片 -->
    <com.copyta.app.TracingView
        android:id="@+id/tracingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 中层：工具栏（加了 clickable 拦截穿透） -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#F2F2F7"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:gravity="center_horizontal"
        android:clickable="true"
        android:focusable="true">

        <Button
            android:id="@+id/loadButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/load_image"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:background="@drawable/bg_load_button"
            android:textColor="#FFFFFF"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <!-- 复位按钮 -->
        <Button
            android:id="@+id/resetButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:text="@string/reset"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:background="@drawable/bg_reset_button"
            android:textColor="#1C1C1E"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp">

            <com.copyta.app.VerticalSeekBar
                android:id="@+id/scaleSeekBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:min="50"
                android:max="300"
                android:progress="100"
                android:progressDrawable="@drawable/seekbar_progress"
                android:thumb="@drawable/seekbar_thumb" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical">

                <TextView style="@style/TickVertical" android:text="3x" />
                <TextView style="@style/TickVertical" android:text="2.5x" />
                <TextView style="@style/TickVertical" android:text="2x" />
                <TextView style="@style/TickVertical" android:text="1.5x" />
                <TextView style="@style/TickVertical" android:text="1x" />
                <TextView style="@style/TickVertical" android:text="0.5x" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:id="@+id/colorWhite"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_swatch_white" />

        <View
            android:id="@+id/colorBlack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_swatch_black" />

        <!-- 锁定按钮 -->
        <ImageButton
            android:id="@+id/lockButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_lock_button"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:src="@drawable/ic_lock_closed"
            android:contentDescription="@string/lock" />

    </LinearLayout>

    <!-- 顶层：浮动解锁按钮（默认隐藏，锁定后出现在左下角） -->
    <ImageButton
        android:id="@+id/floatingUnlockButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_lock_button"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:src="@drawable/ic_lock_open"
        android:visibility="gone"
        android:contentDescription="@string/unlock" />

</FrameLayout>
