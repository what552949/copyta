<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <com.copyta.app.TracingView
        android:id="@+id/tracingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="110dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#F2F2F7"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:gravity="center_horizontal"
        android:clickable="true"
        android:focusable="true">

        <Button
            android:id="@+id/loadButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/load_image"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:background="@drawable/bg_load_button"
            android:textColor="#FFFFFF"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/resetButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:text="@string/reset"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:background="@drawable/bg_reset_button"
            android:textColor="#1C1C1E"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <!-- 竖向滑块，占据中间剩余空间 -->
        <com.copyta.app.ScaleSliderView
            android:id="@+id/scaleSlider"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <View
            android:id="@+id/colorWhite"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_swatch_white" />

        <View
            android:id="@+id/colorBlack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_swatch_black" />

        <ImageButton
            android:id="@+id/lockButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_lock_button"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:src="@drawable/ic_lock_closed"
            android:contentDescription="@string/lock" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/floatingUnlockButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_lock_button"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:src="@drawable/ic_lock_open"
        android:visibility="gone"
        android:contentDescription="@string/unlock" />

</FrameLayout>
